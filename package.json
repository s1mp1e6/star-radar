{
  "name": "star-radar",
  "version": "0.1.3",
  "private": true,
  "description": "开源雷达 StarRadar：0 元成本的 GitHub 开源项目发现与追踪系统（Cloudflare Workers + D1）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute star-radar-db --local --file=migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute star-radar-db --remote --file=migrations/0001_init.sql",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:scrape": "node scripts/smoke.mjs --scrape",
    "integration": "node scripts/integration.mjs",
    "db:backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.122.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
